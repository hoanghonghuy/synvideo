# SynVideo production environment contract (no secrets committed).
# Copy values into Render/Vercel/Neon/AWS secret stores — never into the repository.

# --- Vercel (creator web) ---
# Project root directory: apps/web
# Build command: npm run build (from apps/web package)
# Install command: npm ci (from repository root)
VITE_API_BASE_URL=https://synvideo-api.onrender.com

# --- Render (API + embedded durable-job executors) ---
SYNVIDEO_ENV=production
# Render injects PORT; leave SYNVIDEO_API_ADDR unset unless overriding locally.
SYNVIDEO_DATABASE_URL=postgres://USER:PASSWORD@NEON_HOST/synvideo?sslmode=require
SYNVIDEO_CORS_ALLOWED_ORIGINS=https://synvideo.vercel.app
SYNVIDEO_MEDIA_STORAGE_ENDPOINT=https://s3.amazonaws.com
SYNVIDEO_MEDIA_STORAGE_REGION=us-east-1
SYNVIDEO_MEDIA_STORAGE_BUCKET=synvideo-production
SYNVIDEO_MEDIA_STORAGE_ACCESS_KEY_ID=replace-with-aws-access-key-id
SYNVIDEO_MEDIA_STORAGE_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
SYNVIDEO_MEDIA_STORAGE_PATH_STYLE=false
SYNVIDEO_MEDIA_STORAGE_TIMEOUT=30s
SYNVIDEO_MEDIA_MAX_UPLOAD_BYTES=104857600
SYNVIDEO_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-or-hex-key
SYNVIDEO_CREDENTIAL_KEY_VERSION=v1

# Optional server-side stock media provider (never expose through Vite/client env).
# SYNVIDEO_PEXELS_API_KEY=replace-with-your-pexels-api-key

# Production must NOT set SYNVIDEO_LOCAL_ACTOR_ID.
