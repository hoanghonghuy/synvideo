# SynVideo local development defaults.
# Copy to .env only if you need to override these values locally.

SYNVIDEO_API_ADDR=:8080
SYNVIDEO_ENV=development
SYNVIDEO_DATABASE_URL=postgres://synvideo:synvideo_dev_password@localhost:5432/synvideo?sslmode=disable
SYNVIDEO_LOCAL_ACTOR_ID=11111111-1111-4111-8111-111111111111

POSTGRES_DB=synvideo
POSTGRES_USER=synvideo
POSTGRES_PASSWORD=synvideo_dev_password
POSTGRES_PORT=5432

SYNVIDEO_MEDIA_STORAGE_ENDPOINT=http://localhost:8333
SYNVIDEO_MEDIA_STORAGE_REGION=local
SYNVIDEO_MEDIA_STORAGE_BUCKET=synvideo-local
SYNVIDEO_MEDIA_STORAGE_ACCESS_KEY_ID=synvideo
SYNVIDEO_MEDIA_STORAGE_SECRET_ACCESS_KEY=synvideo_dev_password
SYNVIDEO_MEDIA_STORAGE_PATH_STYLE=true
SYNVIDEO_MEDIA_STORAGE_TIMEOUT=5s
SYNVIDEO_MEDIA_MAX_UPLOAD_BYTES=104857600
SEAWEEDFS_S3_PORT=8333
